# PostgreSQL Docker
POSTGRES_DB=whatsappai
POSTGRES_USER=whatsappai
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Connection String (for user-secrets or environment)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=whatsappai;Username=whatsappai;Password=CHANGE_ME

# Encryption Key (base64 encoded 32 bytes)
Encryption__Key=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Meta WhatsApp (configure after creating Meta App)
Meta__VerifyToken=your-verify-token
Meta__AppSecret=your-app-secret

# PlatformAdmin infrastructure capacity alerts (optional; defaults shown)
InfrastructureCapacity__CustomerLimit=25
InfrastructureCapacity__LineLimit=40
InfrastructureCapacity__OperatorLimit=90
