# MySQL 8.4
MYSQL_DATABASE=whatsappai_dev
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Connection String (for user-secrets or environment)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=whatsappai_dev;User=root;Password=root;CharSet=utf8mb4

# Encryption Key (base64 encoded 32 bytes)
Encryption__Key=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Meta WhatsApp (configure after creating Meta App)
Meta__VerifyToken=your-verify-token
Meta__AppSecret=your-app-secret
