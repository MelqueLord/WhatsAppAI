# Production Environment Configuration
# Copy to .env and fill in real values

# Database
POSTGRES_DB=whatsappai
POSTGRES_USER=whatsappai
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=whatsappai;Username=whatsappai;Password=CHANGE_ME
Persistence__MaxPoolSize=50
Ai__MonthlyTokenBudget=100000
ForwardedHeaders__Enabled=true
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
# Optional OTLP collector for centralized traces, metrics and errors
OpenTelemetry__Endpoint=

# Application
ASPNETCORE_ENVIRONMENT=Production
Encryption__Key=CHANGE_ME_BASE64_32_BYTES
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD

# Meta WhatsApp
Meta__VerifyToken=CHANGE_ME
Meta__AppSecret=CHANGE_ME

# WhatsApp Web bridge for QR Code flow and local Render service
WhatsAppWeb__Enabled=true
WhatsAppWeb__BaseUrl=http://whatsapp-web:3020
WHATSAPP_WEB_API_URL=https://your-api-service.onrender.com/api/webhooks/whatsapp-web
WHATSAPP_WEB_WEBHOOK_SECRET=CHANGE_ME

# Rate Limiting
RateLimiting__GeneralPermitLimit=100
RateLimiting__WebhookPermitLimit=500
RateLimiting__AuthPermitLimit=20

# Nginx
DOMAIN=example.com
